{
  "name": "item-copier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "postinstall": "patch-package --error-on-fail",
    "test:real": "tsx --env-file=.env.local scripts/real-env-test.ts"
  },
  "dependencies": {
    "@kontent-ai/core-sdk": "10.12.11",
    "@kontent-ai/management-sdk": "8.5.7",
    "@kontent-ai/migration-toolkit": "3.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
